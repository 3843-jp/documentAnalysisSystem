# Copy to .env and fill in. docker compose reads .env automatically.

# Required: signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional admin account, created (or promoted) on startup. Admins manage metadata fields.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DIVISION=Division A

# Set to 1 only to run the original starter test_api.py, which uploads without a token.
ALLOW_ANONYMOUS_UPLOAD=0
